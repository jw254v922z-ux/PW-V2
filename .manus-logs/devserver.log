[2026-03-04T07:59:17.825Z] > 1 | import { useEffect, useRef } from "react";\nimport L from "leaflet";\nimport \"leaflet/dist/leaflet.css\";\nimport { SolarInputs } from "@/lib/calculator";\n\ninterface ReportMapProps {\n  inputs: SolarInputs;\n}\n\nexport default function ReportMap({ inputs }: ReportMapProps) {\n  const mapContainer = useRef<HTMLDivElement>(null);\n  const map = useRef<L.Map | null>(null);\n\n  useEffect(() => {\n    if (!mapContainer.current) return;\n\n    // Initialize map\n    if (!map.current) {\n      map.current = L.map(mapContainer.current).setView([51.5074, -0.1278], 10);\n\n      // Add tile layer\n      L.tileLayer(\"https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png\", {\n        attribution: '© OpenStreetMap contributors',\n        maxZoom: 19,\n      }).addTo(map.current);\n    }\n\n    // Load and display polygons from sessionStorage\n    const pvPolygonData = sessionStorage.getItem(\"pvPolygonData\");\n    const cableRouteData = sessionStorage.getItem(\"cableRouteData\");\n\n    // Clear existing layers (except tile layer)\n    map.current.eachLayer((layer) => {\n      if (layer instanceof L.Polygon || layer instanceof L.Polyline) {\n        map.current?.removeLayer(layer);\n      }\n    });\n\n    // Add PV polygon if exists\n    if (pvPolygonData) {\n      try {\n        const coords = JSON.parse(pvPolygonData);\n        if (coords.length > 0) {\n          const polygon = L.polygon(coords, {\n            color: \"#2d8659\",\n            weight: 2,\n            opacity: 0.8,\n            fillOpacity: 0.3,\n          }).addTo(map.current);\n\n          // Fit bounds to polygon\n          map.current.fitBounds(polygon.getBounds());\n        }\n      } catch (error) {\n        console.error(\"Error loading PV polygon:\", error);\n      }\n    }\n\n    // Add cable route if exists\n    if (cableRouteData) {\n      try {\n        const coords = JSON.parse(cableRouteData);\n        if (coords.length > 0) {\n          L.polyline(coords, {\n            color: \"#1e40af\",\n            weight: 3,\n            opacity: 0.7,\n          }).addTo(map.current);\n        }\n      } catch (error) {\n        console.error(\"Error loading cable route:\", error);\n      }\n    }\n  }, [inputs]);\n\n  return (\n    <div\n      ref={mapContainer}\n      className=\"h-96 w-full rounded-lg border border-gray-200 shadow-md\"\n    />\n  );\n}\n
